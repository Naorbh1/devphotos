// אתר הכרויות — סכמת בסיס הנתונים
// Postgres + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// את מי המשתמש מחפש
enum Seeking {
  MEN
  WOMEN
  EVERYONE
}

/// סגנון הקשר שמחפשים
enum RelationshipGoal {
  MARRIAGE
  SERIOUS
  CASUAL
  FRIENDSHIP
  UNSURE
}

enum PhotoKind {
  PROFILE
  MESSAGE
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CommissionType {
  SIGNUP
  PAYMENT
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum PaymentStatus {
  PAID
  REFUNDED
}

// ---------------------------------------------------------------- users

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  statusReason String?
  createdAt    DateTime   @default(now())
  lastActiveAt DateTime   @default(now())

  profile Profile?
  photos  Photo[]

  likesSent     Like[] @relation("LikesSent")
  likesReceived Like[] @relation("LikesReceived")

  matchesAsA Match[] @relation("MatchUserA")
  matchesAsB Match[] @relation("MatchUserB")

  conversationsAsA Conversation[] @relation("ConvUserA")
  conversationsAsB Conversation[] @relation("ConvUserB")

  messagesSent Message[] @relation("MessagesSent")

  blocksMade     Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")

  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")
  reportsHandled  Report[] @relation("ReportHandler")

  photosModerated Photo[] @relation("PhotoModerator")

  affiliate  Affiliate?
  referredBy Referral?  @relation("ReferredUser")
  payments   Payment[]

  @@index([status])
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  birthDate   DateTime
  gender      Gender
  seeking     Seeking
  city        String
  bio         String           @default("")
  goal        RelationshipGoal
  heightCm    Int?
  hasKids     Boolean?
  smokes      Boolean?

  // העדפות חיפוש
  prefMinAge Int    @default(18)
  prefMaxAge Int    @default(99)
  prefCities String @default("") // רשימת ערים מופרדת בפסיקים, ריק = כל הארץ

  isVisible   Boolean   @default(true)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([gender, city])
  @@index([birthDate])
}

model Photo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      PhotoKind        @default(PROFILE)
  storageKey String          // שם הקובץ בתיקיית ההעלאות
  mime      String
  width     Int
  height    Int
  bytes     Int
  isPrimary Boolean          @default(false)
  status    ModerationStatus @default(PENDING)

  moderatedById   String?
  moderatedBy     User?     @relation("PhotoModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt     DateTime?
  rejectionReason String?

  createdAt DateTime  @default(now())
  messages  Message[]
  reports   Report[]

  @@index([userId, kind])
  @@index([status])
}

// ---------------------------------------------------------------- matching

model Like {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("LikesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  isLike     Boolean  @default(true) // false = דילוג
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId, isLike])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}

// ---------------------------------------------------------------- chat

model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userA         User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String
  userB         User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  type    MessageType @default(TEXT)
  body    String?
  photoId String?
  photo   Photo?      @relation(fields: [photoId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  readAt    DateTime?
  deletedAt DateTime?

  reports Report[]

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------- safety

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String  @id @default(cuid())
  reporterId     String
  reporter       User    @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User    @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  photoId        String?
  photo          Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)

  reason  String
  details String @default("")

  status      ReportStatus @default(OPEN)
  handledById String?
  handledBy   User?        @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  resolution  String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- שיווק שותפים

model Affiliate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code   String          @unique
  status AffiliateStatus @default(PENDING)

  /// אחוז עמלה מכל תשלום של מופנה (0-100)
  ratePercent Int @default(25)
  /// בונוס חד-פעמי בשקלים־אגורות על הרשמה שהושלמה
  signupBountyAgorot Int @default(0)

  payoutNotes String   @default("")
  createdAt   DateTime @default(now())

  clicks      AffiliateClick[]
  referrals   Referral[]
  commissions Commission[]
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ipHash      String
  userAgent   String    @default("")
  landingPath String    @default("/")
  createdAt   DateTime  @default(now())

  referral Referral?

  @@index([affiliateId, createdAt])
}

model Referral {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  userId      String    @unique
  user        User      @relation("ReferredUser", fields: [userId], references: [id], onDelete: Cascade)
  clickId     String?   @unique
  click       AffiliateClick? @relation(fields: [clickId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  commissions Commission[]

  @@index([affiliateId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountAgorot  Int
  plan          String
  provider      String        @default("mock")
  externalId    String?
  status        PaymentStatus @default(PAID)
  createdAt     DateTime      @default(now())

  commission Commission?

  @@index([userId, createdAt])
}

model Commission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referralId  String
  referral    Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  paymentId   String?   @unique
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  type         CommissionType
  amountAgorot Int
  status       CommissionStatus @default(PENDING)
  note         String           @default("")
  createdAt    DateTime         @default(now())
  approvedAt   DateTime?
  paidAt       DateTime?

  @@index([affiliateId, status])
}
