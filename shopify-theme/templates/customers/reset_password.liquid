<div class="section">
  <div class="page-width page-width--narrow">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>

    {% form 'reset_customer_password', class: 'stack' %}
      {{ form.errors | default_errors }}

      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.login.password' | t }}</label>
        <input class="input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.confirm' | t }}</label>
        <input class="input" type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button" style="align-self: start;">{{ 'customer.reset_password.submit' | t }}</button>
    {% endform %}
  </div>
</div>
