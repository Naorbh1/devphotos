<div class="section">
  <div class="page-width page-width--narrow">
    <h1>{{ 'customer.register.title' | t }}</h1>

    {% form 'create_customer', class: 'stack' %}
      {{ form.errors | default_errors }}

      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input class="input" type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">
      </div>

      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input class="input" type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">
      </div>

      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
        <input class="input" type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" required>
      </div>

      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
        <input class="input" type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button">{{ 'customer.register.submit' | t }}</button>
    {% endform %}
  </div>
</div>
