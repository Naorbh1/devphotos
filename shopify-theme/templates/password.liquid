<div class="stack">
  {% form 'storefront_password', class: 'newsletter-form' %}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="StorefrontPassword">Password</label>
    <input class="input" type="password" id="StorefrontPassword" name="password" placeholder="Password" required>
    <button type="submit" class="button">Enter</button>
  {% endform %}
</div>
