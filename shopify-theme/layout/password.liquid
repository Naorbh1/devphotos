<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  dir="{% if request.locale.iso_code == 'he' or request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {% style %}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-heading: {{ settings.color_heading }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-border: {{ settings.color_text | color_mix: settings.color_background, 14 }};
        --color-border-strong: {{ settings.color_text | color_mix: settings.color_background, 28 }};
        --color-overlay: {{ settings.color_text | color_to_rgb | remove: 'rgb(' | remove: ')' }};
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --radius: {{ settings.corner_radius }}px;
        --radius-sm: {{ settings.corner_radius | divided_by: 2 }}px;
        --radius-pill: {% if settings.button_style == 'pill' %}999px{% else %}{{ settings.corner_radius }}px{% endif %};
        --space-unit: 8px;
        --page-width: 1320px;
        --font-size-base: 1rem;
      }
    {% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>

  <body style="display: grid; place-items: center; min-height: 100dvh; text-align: center;">
    <main style="padding: 40px 20px; max-width: 460px;">
      {%- if settings.logo -%}
        {%- assign logo_alt = shop.name | escape -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: logo_alt, style: 'margin: 0 auto 24px; width: 160px;' }}
      {%- else -%}
        <h1>{{ shop.name }}</h1>
      {%- endif -%}

      <div class="rte">{{ shop.password_message }}</div>

      <div style="margin-top: 24px;">{{ content_for_layout }}</div>
    </main>
  </body>
</html>
