<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    </div>

    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));">
      {%- for block in section.blocks -%}
        <blockquote class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="rating" aria-label="{{ block.settings.rating }} / 5">
              <span class="rating__stars" aria-hidden="true">
                ★★★★★
                <span class="rating__stars-fill" style="width: {{ block.settings.rating | times: 20 }}%;">★★★★★</span>
              </span>
            </div>
          {%- endif -%}

          <p class="testimonial__quote">{{ block.settings.quote }}</p>

          <footer class="testimonial__author">
            {%- if block.settings.avatar -%}
              {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', class: 'testimonial__avatar', alt: '' }}
            {%- endif -%}
            <div>
              <strong>{{ block.settings.name }}</strong>
              {%- if block.settings.meta != blank -%}
                <div class="text-muted" style="font-size: 0.8rem;">{{ block.settings.meta }}</div>
              {%- endif -%}
            </div>
          </footer>
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "What customers say" },
    {
      "type": "select",
      "id": "background",
      "label": "t:general.background",
      "default": "alt",
      "options": [
        { "value": "default", "label": "t:general.background_default" },
        { "value": "alt", "label": "t:general.background_alt" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.block",
      "settings": [
        { "type": "range", "id": "rating", "label": "t:sections.testimonials.rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "t:sections.testimonials.quote", "default": "Arrived faster than expected and the quality is genuinely better than the photos." },
        { "type": "text", "id": "name", "label": "t:sections.testimonials.author", "default": "Customer name" },
        { "type": "text", "id": "meta", "label": "t:sections.testimonials.meta", "info": "t:sections.testimonials.meta_info" },
        { "type": "image_picker", "id": "avatar", "label": "t:sections.testimonials.avatar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
