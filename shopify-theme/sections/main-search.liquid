{%- paginate search.results by 24 -%}
  <div class="section">
    <div class="page-width">
      <h1>{{ 'general.search.title' | t }}</h1>

      <div data-predictive-search style="max-width: 560px; margin-bottom: 30px;">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
          <input
            class="input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
            aria-label="{{ 'general.search.title' | t }}"
          >
          <input type="hidden" name="type" value="product">
          <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
        </form>
        <div class="predictive-results" data-predictive-results></div>
      </div>

      {%- if search.performed -%}
        <p class="text-muted" style="margin-bottom: 20px;">
          {{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>

        {%- if search.results_count > 0 -%}
          <div class="product-grid" data-product-grid style="--cols-desktop: 4; --cols-mobile: 2;">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'card-product', product: item %}
              {%- else -%}
                <article class="card-product">
                  <a href="{{ item.url }}" class="media">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}
                    {%- endif -%}
                  </a>
                  <div class="card-product__info">
                    <h3 class="card-product__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="cart-empty">
            <p class="h3">{{ 'general.search.no_results' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="button">
              {{ 'sections.cart.continue_shopping' | t }}
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": []
}
{% endschema %}
