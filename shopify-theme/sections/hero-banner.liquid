<div
  class="hero{% if section.settings.text_light %} hero--light{% endif %}"
  style="
    --hero-height: {{ section.settings.height }}vh;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-radius: {% if section.settings.full_width %}0{% else %}var(--radius-lg){% endif %};
    {% unless section.settings.full_width %}max-width: var(--page-width); margin-inline: auto;{% endunless %}
  "
>
  {%- if section.settings.image -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600,900,1200,1600,2000,2600,3000',
          sizes: '100vw',
          alt: section.settings.image.alt | default: section.settings.heading | escape
      }}
    </div>
    <div class="hero__overlay"></div>
  {%- else -%}
    <div class="hero__media">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
    <div class="hero__overlay"></div>
  {%- endif -%}

  <div class="page-width">
    <div class="hero__content hero__content--{{ section.settings.alignment }}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="label" {% if section.settings.text_light %}style="color: rgba(255,255,255,0.85);"{% endif %}>
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 style="margin: 0;">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte" style="font-size: 1.05rem; max-width: 52ch;">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.countdown_to != blank -%}
        <div class="countdown" data-countdown="{{ section.settings.countdown_to }}" data-hide-on-end="true">
          <span class="countdown__unit" data-countdown-days>00</span>
          <span class="countdown__unit" data-countdown-hours>00</span>
          <span class="countdown__unit" data-countdown-minutes>00</span>
          <span class="countdown__unit" data-countdown-seconds>00</span>
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="button button--large">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}

          {%- if section.settings.button_2_label != blank -%}
            <a
              href="{{ section.settings.button_2_link }}"
              class="button button--large button--secondary"
              {% if section.settings.text_light %}style="color: #fff; border-color: rgba(255,255,255,0.6);"{% endif %}
            >
              {{ section.settings.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:general.image" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "New season, new favourites" },
    { "type": "richtext", "id": "text", "label": "t:general.text" },
    {
      "type": "text",
      "id": "countdown_to",
      "label": "t:sections.hero.countdown_to",
      "info": "t:sections.announcement.countdown_to_info"
    },
    { "type": "header", "content": "t:general.buttons" },
    { "type": "text", "id": "button_label", "label": "t:sections.hero.button_label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "t:sections.hero.button_link" },
    { "type": "text", "id": "button_2_label", "label": "t:sections.hero.button_2_label" },
    { "type": "url", "id": "button_2_link", "label": "t:sections.hero.button_2_link" },
    { "type": "header", "content": "t:general.layout" },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:general.alignment",
      "default": "start",
      "options": [
        { "value": "start", "label": "t:general.align_start" },
        { "value": "center", "label": "t:general.align_center" },
        { "value": "end", "label": "t:general.align_end" }
      ]
    },
    { "type": "range", "id": "height", "label": "t:sections.hero.height", "min": 40, "max": 95, "step": 5, "unit": "vh", "default": 68 },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero.overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    { "type": "checkbox", "id": "text_light", "label": "t:sections.hero.text_light", "default": true },
    { "type": "checkbox", "id": "full_width", "label": "t:general.full_width", "default": true }
  ],
  "presets": [{ "name": "t:sections.hero.name" }]
}
{% endschema %}
