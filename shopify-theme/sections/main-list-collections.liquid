<div class="section">
  <div class="page-width">
    <h1>{{ 'sections.collection.all_collections' | t }}</h1>

    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); margin-top: 24px;">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="card-collection" style="aspect-ratio: 3/4;">
          {%- if collection.featured_image -%}
            {{
              collection.featured_image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 750px) 33vw, 90vw', alt: collection.title | escape
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}

          <div class="card-collection__body">
            <h2 class="card-collection__title">{{ collection.title }}</h2>
            <span class="card-collection__count">
              {{ 'sections.collection.product_count' | t: count: collection.all_products_count }}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.list_collections.name",
  "settings": []
}
{% endschema %}
