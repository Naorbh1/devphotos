<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}
            <div class="rte text-muted">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            {{ block.settings.question }}
            <span class="accordion__icon">{% render 'icon', name: 'plus', size: 18 %}</span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "text", "label": "t:general.text" },
    {
      "type": "select",
      "id": "background",
      "label": "t:general.background",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:general.background_default" },
        { "value": "alt", "label": "t:general.background_alt" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.block",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq.question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq.answer", "default": "<p>Orders ship within 1–2 business days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
