{%- paginate blog.articles by 12 -%}
  <div class="section">
    <div class="page-width">
      <h1>{{ blog.title }}</h1>

      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); margin-top: 26px;">
        {%- for article in blog.articles -%}
          <article class="card-product">
            <a href="{{ article.url }}" class="media" style="--media-ratio: 4/3;">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', alt: article.title | escape }}
              {%- else -%}
                {{ 'blog-apparel-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div class="card-product__info">
              <span class="label">{{ article.published_at | date: format: 'date' }}</span>
              <h2 class="h4" style="margin: 0;"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="text-muted" style="font-size: 0.9rem;">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "settings": []
}
{% endschema %}
