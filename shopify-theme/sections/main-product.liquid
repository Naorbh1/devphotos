<div class="section" data-product-handle-meta="{{ product.handle }}">
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="text-muted" style="font-size: 0.84rem; margin-bottom: 18px;" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        {%- if collection -%}
          <span> / </span><a href="{{ collection.url }}">{{ collection.title }}</a>
        {%- endif -%}
        <span> / </span><span>{{ product.title }}</span>
      </nav>
    {%- endif -%}

    <div class="product">
      {% comment %} Gallery {% endcomment %}
      <div class="product__gallery" data-gallery>
        <div class="product__media-main" data-gallery-main>
          {%- if product.featured_media -%}
            {{
              product.featured_media
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '400,600,800,1000,1200,1400',
                sizes: '(min-width: 900px) 55vw, 96vw',
                alt: product.featured_media.alt | default: product.title | escape
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product__thumb"
                data-media-id="{{ media.id }}"
                data-media-src="{{ media | image_url: width: 1400 }}"
                data-media-srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1400 }} 1400w"
                data-media-alt="{{ media.alt | escape }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.view_image' | t: index: forloop.index }}"
              >
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {% comment %} Buy box {% endcomment %}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <span class="label" {{ block.shopify_attributes }}>{{ product.vendor }}</span>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 style="margin: 0;" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              <div {{ block.shopify_attributes }}>{% render 'rating', product: product %}</div>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {% render 'price', product: product, show_unit: true %}
                {%- if block.settings.show_installments -%}
                  <div style="margin-top: 6px;">
                    {%- form 'product', product -%}
                      {{ form | payment_terms }}
                    {%- endform -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              <div class="rte" {{ block.shopify_attributes }}>
                {%- if block.settings.truncate -%}
                  {{ product.description | strip_html | truncatewords: 40 }}
                {%- else -%}
                  {{ product.description }}
                {%- endif -%}
              </div>

            {%- when 'stock' -%}
              <div {{ block.shopify_attributes }}>{% render 'stock-counter', product: product %}</div>

            {%- when 'variant_picker' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'variant-picker', product: product %}
              </div>

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }} data-sticky-anchor>
                {% render 'buy-buttons', product: product, show_dynamic: block.settings.show_dynamic_checkout %}
              </div>

            {%- when 'trust' -%}
              <div class="trust-list" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}
                  <div class="trust-list__item">{% render 'icon', name: block.settings.icon_1, size: 20 %}<span>{{ block.settings.item_1 }}</span></div>
                {%- endif -%}
                {%- if block.settings.item_2 != blank -%}
                  <div class="trust-list__item">{% render 'icon', name: block.settings.icon_2, size: 20 %}<span>{{ block.settings.item_2 }}</span></div>
                {%- endif -%}
                {%- if block.settings.item_3 != blank -%}
                  <div class="trust-list__item">{% render 'icon', name: block.settings.icon_3, size: 20 %}<span>{{ block.settings.item_3 }}</span></div>
                {%- endif -%}

                {%- if block.settings.show_payment_icons and settings.enable_payment_icons -%}
                  <div class="payment-icons" style="margin-top: 4px;">
                    {%- for type in shop.enabled_payment_types -%}
                      {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'collapsible' -%}
              <details class="accordion__item" {{ block.shopify_attributes }} style="border-top: 1px solid var(--color-border);">
                <summary class="accordion__summary">
                  {{ block.settings.heading }}
                  <span class="accordion__icon">{% render 'icon', name: 'plus', size: 18 %}</span>
                </summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}
                    {{ block.settings.page.content }}
                  {%- endif -%}
                </div>
              </details>

            {%- when 'share' -%}
              {%- if settings.enable_share_buttons -%}
                <div class="inline" {{ block.shopify_attributes }} style="font-size: 0.85rem;">
                  <span class="text-muted">{{ 'products.product.share' | t }}</span>
                  {%- assign share_url = shop.url | append: product.url | url_encode -%}
                  <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                    {% render 'icon', name: 'facebook', size: 18 %}
                  </a>
                  <a href="https://wa.me/?text={{ share_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                    {% render 'icon', name: 'whatsapp', size: 18 %}
                  </a>
                  <a href="mailto:?body={{ share_url }}" aria-label="Email">
                    {% render 'icon', name: 'mail', size: 18 %}
                  </a>
                </div>
              {%- endif -%}

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- if settings.enable_sticky_atc -%}
  {% render 'sticky-atc', product: product %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "settings": [{ "type": "checkbox", "id": "show_breadcrumbs", "label": "t:sections.main_product.breadcrumbs", "default": true }],
  "blocks": [
    { "type": "vendor", "name": "t:sections.main_product.vendor", "limit": 1 },
    { "type": "title", "name": "t:general.heading", "limit": 1 },
    { "type": "rating", "name": "t:sections.main_product.rating", "limit": 1 },
    {
      "type": "price",
      "name": "t:sections.main_product.price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_installments", "label": "t:sections.main_product.installments", "default": true }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.main_product.description",
      "settings": [{ "type": "checkbox", "id": "truncate", "label": "t:sections.main_product.truncate", "default": false }]
    },
    { "type": "stock", "name": "t:sections.main_product.stock", "limit": 1 },
    { "type": "variant_picker", "name": "t:sections.main_product.variant_picker", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.buy_buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.main_product.dynamic_checkout", "default": true }
      ]
    },
    {
      "type": "trust",
      "name": "t:sections.main_product.trust",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon_1",
          "label": "t:sections.value_props.icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Shipping" },
            { "value": "refresh", "label": "Returns" },
            { "value": "shield", "label": "Warranty" },
            { "value": "lock", "label": "Secure" },
            { "value": "support", "label": "Support" },
            { "value": "clock", "label": "Fast" }
          ]
        },
        { "type": "text", "id": "item_1", "label": "t:general.text", "default": "Free shipping over $200" },
        {
          "type": "select",
          "id": "icon_2",
          "label": "t:sections.value_props.icon",
          "default": "refresh",
          "options": [
            { "value": "truck", "label": "Shipping" },
            { "value": "refresh", "label": "Returns" },
            { "value": "shield", "label": "Warranty" },
            { "value": "lock", "label": "Secure" },
            { "value": "support", "label": "Support" },
            { "value": "clock", "label": "Fast" }
          ]
        },
        { "type": "text", "id": "item_2", "label": "t:general.text", "default": "30-day returns" },
        {
          "type": "select",
          "id": "icon_3",
          "label": "t:sections.value_props.icon",
          "default": "lock",
          "options": [
            { "value": "truck", "label": "Shipping" },
            { "value": "refresh", "label": "Returns" },
            { "value": "shield", "label": "Warranty" },
            { "value": "lock", "label": "Secure" },
            { "value": "support", "label": "Support" },
            { "value": "clock", "label": "Fast" }
          ]
        },
        { "type": "text", "id": "item_3", "label": "t:general.text", "default": "Secure checkout" },
        { "type": "checkbox", "id": "show_payment_icons", "label": "t:settings.conversion.payment_icons", "default": true }
      ]
    },
    {
      "type": "collapsible",
      "name": "t:sections.main_product.collapsible",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "t:general.text" },
        { "type": "page", "id": "page", "label": "t:sections.main_product.page_content" }
      ]
    },
    { "type": "share", "name": "t:sections.main_product.share", "limit": 1 },
    { "type": "@app" }
  ]
}
{% endschema %}
