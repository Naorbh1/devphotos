<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="page-width">
    <div
      class="grid"
      style="
        grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
        align-items: center;
        gap: clamp(24px, 5vw, 60px);
      "
    >
      <div style="{% if section.settings.image_position == 'end' %}order: 2;{% endif %}">
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000,1400',
              sizes: '(min-width: 750px) 50vw, 92vw',
              style: 'border-radius: var(--radius-lg); width: 100%;',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="media" style="--media-ratio: 4/3; border-radius: var(--radius-lg);">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <div class="stack">
        {%- if section.settings.eyebrow != blank -%}
          <span class="label">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="margin: 0;">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="stack" style="gap: 10px;">
            {%- for block in section.blocks -%}
              <li class="trust-list__item" {{ block.shopify_attributes }}>
                {% render 'icon', name: 'check', size: 18 %}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button" style="align-self: start;">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:general.image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_with_text.image_position",
      "default": "start",
      "options": [
        { "value": "start", "label": "t:general.align_start" },
        { "value": "end", "label": "t:general.align_end" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Made to last" },
    { "type": "richtext", "id": "text", "label": "t:general.text" },
    { "type": "text", "id": "button_label", "label": "t:sections.hero.button_label" },
    { "type": "url", "id": "button_link", "label": "t:sections.hero.button_link" },
    {
      "type": "select",
      "id": "background",
      "label": "t:general.background",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:general.background_default" },
        { "value": "alt", "label": "t:general.background_alt" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "t:sections.image_with_text.bullet",
      "settings": [{ "type": "text", "id": "text", "label": "t:general.text", "default": "Free returns within 30 days" }]
    }
  ],
  "presets": [{ "name": "t:sections.image_with_text.name" }]
}
{% endschema %}
